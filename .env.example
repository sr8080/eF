# Copy to .env.local and fill in. Never commit .env.local.

# --- Supabase (Project Settings → API) -------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The "publishable" key (sb_publishable_...) or, on older projects, the "anon" key.
# Safe to expose to the browser: RLS policies protect the data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Public URL of the app, used for auth email links and invite links.
# Local: http://localhost:3000   Production: https://your-app.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Server-only (never prefix with NEXT_PUBLIC_) ---------------------------
# Not required for Phase 1. Only used by server-only code paths later, if at all.
# SUPABASE_SERVICE_ROLE_KEY=

# --- Optional: AI screenshot extraction (Phase 5) ---------------------------
# Leave unset to run without AI; users enter scores manually.
# AI_VISION_PROVIDER=none
# AI_VISION_API_KEY=
